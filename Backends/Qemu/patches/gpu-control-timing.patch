--- /dev/null
+++ b/hw/display/mvo-gpu-timing.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Original macOpenVM bounded numeric diagnostics. BQL-owned call sites only.
+ * No payload, pixels, resources, pointers or guest text are logged.
+ */
+#ifndef MVO_GPU_TIMING_H
+#define MVO_GPU_TIMING_H
+#include "qemu/error-report.h"
+
+/* virtqueue_pop uses g_malloc, not zero-initialized storage. Initialize only
+ * original diagnostic fields before the command enters either queue. */
+static inline void mvo_gpu_timing_initialize(struct virtio_gpu_ctrl_command *cmd)
+{
+    cmd->mvo_started_us = 0;
+    cmd->mvo_timing_sequence = 0;
+    cmd->mvo_pending_noted = false;
+}
+
+static inline void mvo_gpu_timing_note(VirtIOGPU *g,
+                                      struct virtio_gpu_ctrl_command *cmd,
+                                      const char *event, int64_t span_us,
+                                      int64_t now)
+{
+    if (g->mvo_timing_records >= 256) {
+        return;
+    }
+    g->mvo_timing_records++;
+    error_report("macOpenVM GPU timing: event=%s seq=%" PRIu64
+                 " type=0x%x ctx=%u flags=0x%x ring=%u fence=%" PRIu64
+                 " span_us=%" PRId64 " reply_age_us=%" PRId64
+                 " reply_wait_us=%" PRId64 " inflight=%u blocked=%d",
+                 event, cmd->mvo_timing_sequence, cmd->cmd_hdr.type,
+                 cmd->cmd_hdr.ctx_id, cmd->cmd_hdr.flags,
+                 cmd->cmd_hdr.flags & VIRTIO_GPU_FLAG_INFO_RING_IDX
+                    ? cmd->cmd_hdr.ring_idx : UINT32_MAX,
+                 cmd->cmd_hdr.fence_id, span_us,
+                 g->mvo_last_reply_us ? now - g->mvo_last_reply_us : -1,
+                 g->mvo_last_reply_wait_us, g->inflight,
+                 g->parent_obj.renderer_blocked);
+    if (g->mvo_timing_records == 256) {
+        error_report("macOpenVM GPU timing: 256-record budget exhausted");
+    }
+}
+
+static inline void mvo_gpu_timing_started(VirtIOGPU *g,
+                                          struct virtio_gpu_ctrl_command *cmd)
+{
+    if (!virtio_gpu_neptune_enabled(g->parent_obj.conf) || cmd->mvo_started_us) {
+        return;
+    }
+    int64_t now = g_get_monotonic_time();
+    cmd->mvo_started_us = now;
+    cmd->mvo_timing_sequence = ++g->mvo_timing_sequence;
+    if (g->mvo_last_command_us && now - g->mvo_last_command_us >= 100000) {
+        mvo_gpu_timing_note(g, cmd, "command-gap", now - g->mvo_last_command_us, now);
+    }
+    g->mvo_last_command_us = now;
+}
+
+static inline void mvo_gpu_timing_replied(VirtIOGPU *g,
+                                          struct virtio_gpu_ctrl_command *cmd)
+{
+    if (!cmd->mvo_started_us) {
+        return;
+    }
+    int64_t now = g_get_monotonic_time();
+    int64_t elapsed = now - cmd->mvo_started_us;
+    if (elapsed >= 50000) {
+        mvo_gpu_timing_note(g, cmd, "reply", elapsed, now);
+    }
+    g->mvo_last_reply_us = now;
+    g->mvo_last_reply_wait_us = elapsed;
+}
+
+static inline void mvo_gpu_timing_pending(VirtIOGPU *g)
+{
+    struct virtio_gpu_ctrl_command *cmd = QTAILQ_FIRST(&g->fenceq);
+    if (!cmd || !cmd->mvo_started_us || cmd->mvo_pending_noted) {
+        return;
+    }
+    int64_t now = g_get_monotonic_time();
+    if (now - cmd->mvo_started_us >= 250000) {
+        cmd->mvo_pending_noted = true;
+        mvo_gpu_timing_note(g, cmd, "pending", now - cmd->mvo_started_us, now);
+    }
+}
+#endif
