+/* Called under BQL after stopping the device, never from its realtime callback.
+ * A fixed process-wide budget prevents repeated device changes growing logs. */
+static unsigned mvo_playback_report_budget = 8;
+
+static void mvo_report_playback(CoreaudioVoiceOut *core)
+{
+    if (coreaudio_voice_out_buf_lock(core, "mvo_report_playback")) {
+        return;
+    }
+    if (mvo_playback_report_budget && core->mvo_callbacks) {
+        mvo_playback_report_budget--;
+        info_report("macOpenVM audio playback: callbacks=%" PRIu64
+                    " delivered_frames=%" PRIu64 " nonzero_samples=%" PRIu64
+                    " underrun_callbacks=%" PRIu64,
+                    core->mvo_callbacks, core->mvo_delivered_frames,
+                    core->mvo_nonzero_samples, core->mvo_underrun_callbacks);
+    }
+    coreaudio_voice_out_buf_unlock(core, "mvo_report_playback");
+}
