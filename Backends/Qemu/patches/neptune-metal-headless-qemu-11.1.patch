@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "mvo-metal-readback.h"
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+void *mvo_metal_retain(void *texture)
+{
+    return [(id<MTLTexture>)texture retain];
+}
+
+void mvo_metal_release(void *texture)
+{
+    [(id<MTLTexture>)texture release];
+}
+
+bool mvo_metal_can_read(void *texture)
+{
+    id<MTLTexture> t = (id<MTLTexture>)texture;
+    return t && t.storageMode == MTLStorageModeShared &&
+        (t.pixelFormat == MTLPixelFormatBGRA8Unorm ||
+         t.pixelFormat == MTLPixelFormatBGRA8Unorm_sRGB ||
+         t.pixelFormat == MTLPixelFormatRGBA8Unorm ||
+         t.pixelFormat == MTLPixelFormatRGBA8Unorm_sRGB);
+}
+
+bool mvo_metal_copy(void *texture, uint8_t *target, uint32_t stride,
+                    uint32_t width, uint32_t height, uint32_t x, uint32_t y)
+{
+    @autoreleasepool {
+        id<MTLTexture> t = (id<MTLTexture>)texture;
+        if (!mvo_metal_can_read(texture) || !target || !width || !height ||
+            (uint64_t)width * 4 > stride || x > t.width || y > t.height ||
+            width > t.width - x || height > t.height - y) {
+            return false;
+        }
+        [t getBytes:target bytesPerRow:stride
+            fromRegion:MTLRegionMake2D(x, y, width, height) mipmapLevel:0];
+        if (t.pixelFormat == MTLPixelFormatRGBA8Unorm ||
+            t.pixelFormat == MTLPixelFormatRGBA8Unorm_sRGB) {
+            for (uint32_t row = 0; row < height; row++) {
+                uint8_t *p = target + (uint64_t)row * stride;
+                for (uint32_t col = 0; col < width; col++, p += 4) {
+                    uint8_t red = p[0]; p[0] = p[2]; p[2] = red;
+                }
+            }
+        }
+        return true;
+    }
+}
