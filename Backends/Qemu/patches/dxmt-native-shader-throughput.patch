 namespace std {
 template <> struct hash<dxmt::ShaderVariant> {
   size_t operator()(const dxmt::ShaderVariant &v) const noexcept {
-    return v.index(); // FIXME:
+    dxmt::HashState state;
+    state.add(v.index());
+    std::visit([&](const auto &variant) {
+      using Variant = std::decay_t<decltype(variant)>;
+      if constexpr (std::is_same_v<Variant, dxmt::ShaderVariantVertex>) {
+        state.add(reinterpret_cast<size_t>(variant.input_layout_handle));
+        state.add(variant.gs_passthrough);
+        state.add(variant.rasterization_disabled);
+      } else if constexpr (std::is_same_v<Variant, dxmt::ShaderVariantPixel>) {
+        state.add(variant.sample_mask);
+        state.add(variant.dual_source_blending);
+        state.add(variant.disable_depth_output);
+        state.add(variant.unorm_output_reg_mask);
+        state.add(variant.uint_output_reg_mask);
+        state.add(variant.sint_output_reg_mask);
+      } else if constexpr (std::is_same_v<Variant, dxmt::ShaderVariantTessellationVertexHull>) {
+        state.add(reinterpret_cast<size_t>(variant.input_layout_handle));
+        state.add(reinterpret_cast<size_t>(variant.vertex_shader_handle));
+        state.add(variant.index_buffer_format);
+        state.add(variant.max_potential_tess_factor);
+      } else if constexpr (std::is_same_v<Variant, dxmt::ShaderVariantTessellationDomain>) {
+        state.add(reinterpret_cast<size_t>(variant.hull_shader_handle));
+        state.add(variant.gs_passthrough);
+        state.add(variant.max_potential_tess_factor);
+        state.add(variant.rasterization_disabled);
+      } else if constexpr (std::is_same_v<Variant, dxmt::ShaderVariantVertexStreamOutput>) {
+        state.add(reinterpret_cast<size_t>(variant.input_layout_handle));
+        state.add(variant.stream_output_layout_handle);
+      } else if constexpr (std::is_same_v<Variant, dxmt::ShaderVariantGeometryVertex>) {
+        state.add(reinterpret_cast<size_t>(variant.input_layout_handle));
+        state.add(reinterpret_cast<size_t>(variant.geometry_shader_handle));
+        state.add(variant.index_buffer_format);
+        state.add(variant.strip_topology);
+      } else if constexpr (std::is_same_v<Variant, dxmt::ShaderVariantGeometry>) {
+        state.add(reinterpret_cast<size_t>(variant.vertex_shader_handle));
+        state.add(variant.strip_topology);
+      }
+    }, v);
+    return state;
   };
 };
 } // namespace std
