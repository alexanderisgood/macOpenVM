+++ b/ui/mvo-metal-damage.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Private generated-pixel prototype. Not installed in the running backend. */
+#ifndef MVO_DAMAGE_PLAN_H
+#define MVO_DAMAGE_PLAN_H
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct MVODamagePlan {
+    uint32_t source_x, source_y, destination_x, destination_y, width, height;
+} MVODamagePlan;
+
+static inline bool mvo_damage_plan(uint32_t sx, uint32_t sy,
+                                  uint32_t sw, uint32_t sh,
+                                  uint32_t dw, uint32_t dh,
+                                  uint32_t x, uint32_t y,
+                                  uint32_t w, uint32_t h,
+                                  bool force_full, MVODamagePlan *out)
+{
+    if (!out) {
+        return false;
+    }
+    *out = (MVODamagePlan){0};
+    /* Partial copies require exact surface/scanout geometry. */
+    if (!sw || !sh || sw != dw || sh != dh ||
+        (uint64_t)sx + sw > UINT32_MAX || (uint64_t)sy + sh > UINT32_MAX) {
+        return false;
+    }
+    if (force_full) {
+        *out = (MVODamagePlan){sx, sy, 0, 0, sw, sh};
+        return true;
+    }
+    if (!w || !h) {
+        return true;
+    }
+    /* Flush coordinates belong to the resource, not to its cropped scanout. */
+    uint64_t left = x > sx ? x : sx;
+    uint64_t top = y > sy ? y : sy;
+    uint64_t right = (uint64_t)x + w;
+    uint64_t bottom = (uint64_t)y + h;
+    if (right > (uint64_t)sx + sw) {
+        right = (uint64_t)sx + sw;
+    }
+    if (bottom > (uint64_t)sy + sh) {
+        bottom = (uint64_t)sy + sh;
+    }
+    if (left >= right || top >= bottom) {
+        return true;
+    }
+    *out = (MVODamagePlan){(uint32_t)left, (uint32_t)top,
+        (uint32_t)(left - sx), (uint32_t)(top - sy),
+        (uint32_t)(right - left), (uint32_t)(bottom - top)};
+    return true;
+}
+#endif
