+   CHECK(test_pool.entries[0] == &resources[0]);
+   CHECK(test_pool.entries[1] == &resources[1]);
+   CHECK(test_pool.entries[2] == &resources[2]);
+   release_texture(acquire(&resources[3], &key));
+   CHECK(resources[0].texture == NULL && backend.attempts == 5);
