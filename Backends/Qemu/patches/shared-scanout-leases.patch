+bool mvo_shared_frame_attach_leases(MVOSharedFrameServer *s, void *owner,
+                                   int console, uint32_t width, uint32_t height,
+                                   uint32_t stride, size_t length,
+                                   const int fds[LEASED_SLOTS],
+                                   const MVOSharedFrameLeaseOps *ops, void *producer)
+{
+    uint64_t logical = (uint64_t)stride * height;
+    if (!s || !owner || !producer || !ops || !ops->take_latest || !ops->release ||
+        !ops->retire || !fds || s->peer < 0 || s->lease_ops ||
+        s->waiting_ack || s->tx_used != PACKET || console != selected_console ||
+        !width || !height || width > 8192 || height > 8192 ||
+        (uint64_t)width * height > 16777216 ||
+        stride < width * 4 || stride > width * 4 + 4096 || stride % 256 ||
+        length < logical || length >= logical + getpagesize() ||
+        length % getpagesize() || length > 67108864) {
+        return false;
+    }
+
+    int duplicates[LEASED_SLOTS];
+    unsigned copied = 0;
+    for (; copied < LEASED_SLOTS; ++copied) {
+        struct stat actual;
+        int fd = fds[copied];
+        int flags = fcntl(fd, F_GETFL);
+        if (flags < 0 || (flags & O_ACCMODE) != O_RDONLY || fstat(fd, &actual) ||
+            actual.st_size != length || actual.st_uid != geteuid() ||
+            actual.st_nlink || (actual.st_mode & (S_IFMT | 0777)) != 0600) {
+            break;
+        }
+        duplicates[copied] = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+        if (duplicates[copied] < 0) {
+            break;
+        }
+    }
+    if (copied != LEASED_SLOTS) {
+        while (copied) {
+            close(duplicates[--copied]);
+        }
+        return false;
+    }
+
+    bool replacement = s->length != 0;
+    clear_pool(s);
+    memcpy(s->input_fd, duplicates, sizeof(duplicates));
+    s->lease_ops = ops;
+    s->lease_producer = producer;
+    s->lease_owner = owner;
+    s->lease_replaces_epoch = replacement;
+    s->width = width;
+    s->height = height;
+    s->stride = stride;
+    s->length = length;
+    s->sequence = s->last_generation = 0;
+    advance(s);
+    /* Ownership transferred even if the initial send retired the stream. */
+    return true;
+}
