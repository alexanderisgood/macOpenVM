--- /dev/null
+++ b/ui/mvo-metal-swizzle.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef MVO_METAL_SWIZZLE_H
+#define MVO_METAL_SWIZZLE_H
+#include <stdint.h>
+#if defined(__aarch64__) && defined(__ARM_NEON)
+#include <arm_neon.h>
+#endif
+
+/* The caller supplies exactly width complete RGBA pixels; padding is untouched. */
+static inline void mvo_rgba_to_bgra_row(uint8_t *pixels, uint32_t width)
+{
+    uint32_t remaining = width;
+#if defined(__aarch64__) && defined(__ARM_NEON)
+    const uint8x16_t order = {2, 1, 0, 3, 6, 5, 4, 7, 10, 9, 8, 11, 14, 13, 12, 15};
+    while (remaining >= 4) {
+        uint8x16_t rgba = vld1q_u8(pixels);
+        vst1q_u8(pixels, vqtbl1q_u8(rgba, order));
+        pixels += 16;
+        remaining -= 4;
+    }
+#endif
+    while (remaining--) {
+        uint8_t red = pixels[0]; pixels[0] = pixels[2]; pixels[2] = red;
+        pixels += 4;
+    }
+}
+#endif
