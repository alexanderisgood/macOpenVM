+    arc4random_buf(s->epoch,sizeof s->epoch);qemu_set_fd_handler(fd,read_peer,NULL,s);
+    uint8_t b[PACKET];header(s,b,READY);start_tx(s,b,false,false);
+}
+MVOSharedFrameServer *mvo_shared_frame_new(const char *path,Error **errp)
+{
+    if (!path) return NULL;
+    struct sockaddr_un addr={0};
+    if (singleton || path[0]!='/' || strlen(path)>=sizeof addr.sun_path) {
+        error_setg(errp,"Invalid shared host-frame endpoint");return NULL;
+    }
