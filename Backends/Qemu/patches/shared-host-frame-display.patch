+        fcntl(fd,F_SETFD,FD_CLOEXEC) || listen(fd,1)) {
+        if (fd>=0) close(fd);timer_free(s->deadline);g_free(s);
+        error_setg(errp,"Could not create shared host-frame endpoint");return NULL;
+    }
+    s->listener=fd;singleton=s;qemu_set_fd_handler(fd,accept_peer,NULL,s);return s;
+}
+void mvo_shared_frame_update(MVOSharedFrameServer *s,void *owner,int console,
+                            const uint8_t *pixels,uint32_t width,uint32_t height,uint32_t stride)
+{
+    if (!s || console!=selected_console || !pixels || !width || !height || width>8192 || height>8192 ||
+        (uint64_t)width*height>16777216 || (uint64_t)width*4>stride || stride>width*4+4096) return;
+    if (s->generation==UINT64_MAX) { close_peer(s);return; }
+    s->source_owner=owner;s->source_console=console;s->source=pixels;
+    s->source_width=width;s->source_height=height;s->source_stride=stride;s->generation++;
+    advance(s);
+}
+void mvo_shared_frame_invalidate(MVOSharedFrameServer *s,void *owner)
+{
+    if (s && s->source_owner==owner) { s->source=NULL;s->source_owner=NULL;close_peer(s); }
+}
+void mvo_shared_frame_selected(int console)
+{
+    if (selected_console!=console) {
+        selected_console=console;
+        if (singleton) close_peer(singleton);
+    }
+}
