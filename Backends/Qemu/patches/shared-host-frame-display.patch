+    bool valid=!lstat(directory,&parent) && S_ISDIR(parent.st_mode) &&
+        parent.st_uid==geteuid() && (parent.st_mode&0777)==0700 &&
+        lstat(path,&existing)<0 && errno==ENOENT;
+    g_free(directory);
